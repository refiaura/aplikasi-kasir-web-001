# Salin ke .env lalu sesuaikan
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://kasir:kasir@localhost:5432/kasir
# Wajib diganti di production: string acak minimal 32 karakter
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Set "true" bila API diakses via HTTPS
COOKIE_SECURE=false
# Untuk vite dev (kosongkan bila web diserve nginx yang memproksi /api)
VITE_API_URL=http://localhost:8080
